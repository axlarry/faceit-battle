# Supabase Edge Function Environment Variables
# Copy this file to .env.local and fill in the values
# These are configured in Supabase Dashboard → Project Settings → Edge Functions → Environment variables

# Supabase connection (auto-set by Supabase, but documented here)
SUPABASE_URL=https://rwizxoeyatdtggrpnpmq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Fossabot Custom API Proxy URL
# Get this from Fossabot dashboard → Custom API → your project settings
# Format: https://api.fossabot.com/customapi/{projectId}/{YOUR_ENDPOINT_NAME}
FOSSABOT_PROXY_URL=https://api.fossabot.com/customapi/YOUR_PROJECT_ID/YOUR_ENDPOINT_NAME
